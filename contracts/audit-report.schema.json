{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkhouse.local/contracts/audit-report.schema.json",
  "title": "AuditReport",
  "description": "Enriched AuditReport envelope (second schema version of the ScanResult envelope). Adds analyst impacts and architect patches; consumed by the web tier starting 1.2. schemaVersion is mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scanId",
    "violations",
    "vitals",
    "analyst_impacts",
    "architect_patches"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "scanId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/violation"
      }
    },
    "vitals": {
      "$ref": "#/definitions/vitals"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "analyst_impacts": {
      "type": "array",
      "description": "Populated in later epics. Scaffolded now to keep the envelope shape stable.",
      "items": {
        "$ref": "#/definitions/analyst_impact"
      }
    },
    "architect_patches": {
      "type": "array",
      "description": "Populated in later epics. Scaffolded now; patches are always proposed, never applied.",
      "items": {
        "$ref": "#/definitions/architect_patch"
      }
    }
  },
  "definitions": {
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "impact",
        "description",
        "helpUrl",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "impact": {
          "type": "string",
          "enum": ["critical", "serious", "moderate", "minor"]
        },
        "description": {
          "type": "string"
        },
        "helpUrl": {
          "type": ["string", "null"]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "coordinates"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "coordinates": {
          "$ref": "#/definitions/coordinates"
        }
      }
    },
    "coordinates": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "vitals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lcp", "inp", "cls"],
      "properties": {
        "lcp": { "type": ["number", "null"] },
        "inp": { "type": ["number", "null"] },
        "cls": { "type": ["number", "null"] }
      }
    },
    "analyst_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "violation_id",
        "business_problem",
        "affected_segment",
        "wcag_consequence",
        "conversion_impact_estimate"
      ],
      "properties": {
        "violation_id": {
          "type": "string"
        },
        "business_problem": {
          "type": "string"
        },
        "affected_segment": {
          "type": "string"
        },
        "wcag_consequence": {
          "type": "string"
        },
        "conversion_impact_estimate": {
          "type": "string"
        }
      }
    },
    "architect_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diff",
        "rationale",
        "wcag_rule"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "diff": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "wcag_rule": {
          "type": "string"
        }
      }
    }
  }
}